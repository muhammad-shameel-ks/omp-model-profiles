{
  "name": "omp-model-profiles",
  "version": "0.1.0",
  "description": "Named model + thinking-level profiles for Oh My Pi (omp): a fullscreen dashboard to apply, snapshot, and edit role and agent model assignments",
  "type": "module",
  "main": "./model-profiles.ts",
  "exports": {
    ".": "./model-profiles.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhammad-shameel-ks/omp-model-profiles.git"
  },
  "bugs": {
    "url": "https://github.com/muhammad-shameel-ks/omp-model-profiles/issues"
  },
  "homepage": "https://github.com/muhammad-shameel-ks/omp-model-profiles#readme",
  "author": "Muhammad Shameel",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "model-profiles.ts",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "omp",
    "oh-my-pi",
    "pi-package",
    "omp-package",
    "extension",
    "plugin",
    "model-profiles",
    "model-roles",
    "thinking-level",
    "tui"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "omp": {
    "extensions": [
      "./model-profiles.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./model-profiles.ts"
    ]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": ">=18.4.3",
    "@oh-my-pi/pi-coding-agent": ">=18.4.3",
    "@oh-my-pi/pi-tui": ">=18.4.3"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "^18.4.3",
    "@oh-my-pi/pi-coding-agent": "^18.4.3",
    "@oh-my-pi/pi-tui": "^18.4.3",
    "@types/bun": "latest",
    "typescript": ">=5.8"
  }
}
